ENV=development

API_KEY="your-api-key"
# Comma-separated list of allowed origins for CORS in production.
# Ignored when ENV=development (all origins are allowed).
CORS_ALLOW_ORIGINS="https://example.com,https://app.example.com"

NOVITA_API_KEY="your-api-key"
PINECONE_API_KEY="your-api-key"

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY="your-api-key"
LANGSMITH_PROJECT="lovelytics-task"
